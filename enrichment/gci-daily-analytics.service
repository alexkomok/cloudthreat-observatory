[Unit]
Description=Generate daily Cowrie attack analytics
After=gci-enrichment.service

[Service]
Type=oneshot
User=gci-enricher
Group=gci-enricher
ExecStart=/usr/bin/python3 /opt/gci-enrichment/daily_analytics.py
WorkingDirectory=/var/lib/gci-enrichment
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadOnlyPaths=/var/lib/gci-enrichment/attacks.sqlite
ReadWritePaths=/var/lib/gci-enrichment/metrics

